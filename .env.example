# Скопируйте этот файл в .env.local и заполните своими значениями.
# .env.local никогда не попадает в git (см. .gitignore).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Telegram-бот для уведомлений о заказах (см. README.md → "Telegram-уведомления")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Отдельный Telegram-бот для предраспива (см. README.md → "Бот предраспива")
PRESPLIT_BOT_TOKEN=
PRESPLIT_ADMIN_CHAT_ID=
PRESPLIT_ADMIN_USERNAME=
