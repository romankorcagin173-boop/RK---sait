# Скопируйте этот файл в .env.local и заполните своими значениями.
# .env.local никогда не попадает в git (см. .gitignore).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Только для Telegram-бота-магазина (npm run bot) — Project Settings → API →
# "service_role" secret key. НИКОГДА не используйте этот ключ на сайте и не
# публикуйте его — он обходит все правила безопасности базы данных.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram-бот: и для уведомлений о заказах с сайта, и для бота-магазина
# (см. README.md → "Telegram-уведомления" и "Telegram-бот-магазин")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
